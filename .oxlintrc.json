{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "vitest"],
  "categories": { "correctness": "error" },
  "env": { "node": true, "browser": true, "es2024": true },
  "ignorePatterns": ["dist/**", "test/fixtures/**", "test/e2e/fixtures/**"],
  "rules": {
    "no-unused-vars": ["error", { "ignoreRestSiblings": true, "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-unused-expressions": "off",
    "no-control-regex": "off",
    "unicorn/no-new-array": "off",
    "unicorn/prefer-string-starts-ends-with": "error",
    "react/jsx-key": "off",
    "react/immutability": "off",
    "react/purity": "off",
    "react/refs": "off",
    "react/set-state-in-effect": "off",
    "react-hooks/exhaustive-deps": "warn",
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],
    "vitest/require-to-throw-message": "off",
    "vitest/require-mock-type-parameters": "off"
  }
}
