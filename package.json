{
  "name": "landfall",
  "version": "0.17.0",
  "description": "Set up servers and deploy sites behind Traefik with automatic HTTPS",
  "keywords": [
    "cli",
    "deploy",
    "docker",
    "https",
    "self-hosted",
    "traefik",
    "vps"
  ],
  "homepage": "https://ph1p.github.io/landfall/",
  "bugs": "https://github.com/ph1p/landfall/issues",
  "license": "MIT",
  "author": "ph1p <me@ph1p.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ph1p/landfall.git"
  },
  "bin": {
    "landfall": "dist/cli.mjs",
    "lf": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "tsx src/cli/cli.ts",
    "build": "tsdown && vite build",
    "docs:dev": "cd docs && vocs dev",
    "docs:build": "cd docs && vocs build",
    "prepublishOnly": "pnpm build",
    "test": "vitest run test/unit",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/ui/app",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "e2e": "pnpm build && bash test/e2e/run.sh",
    "dev:ui": "vite build --watch",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run --no-ci"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "string-width": "^9.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "15.0.0-beta.3",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "lucide-react": "^1.80.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semantic-release": "^26.0.1",
    "tailwindcss": "^4.3.5",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2",
    "vocs": "2.14.1",
    "waku": "1.0.0-rc.5"
  },
  "engines": {
    "node": ">=22.4"
  },
  "packageManager": "pnpm@12.23.0"
}
