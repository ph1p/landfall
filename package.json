{
  "name": "landfall",
  "version": "0.8.3",
  "description": "Set up servers and deploy sites behind Traefik with automatic HTTPS",
  "author": "ph1p <me@ph1p.dev>",
  "license": "MIT",
  "keywords": [
    "deploy",
    "traefik",
    "docker",
    "self-hosted",
    "vps",
    "https",
    "cli"
  ],
  "type": "module",
  "bin": {
    "landfall": "dist/cli.mjs",
    "lf": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.4"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsdown && vite build",
    "prepublishOnly": "pnpm build",
    "test": "vitest run test/unit",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web/app",
    "e2e": "pnpm build && bash test/e2e/run.sh",
    "dev:ui": "vite build --watch"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "string-width": "^8.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
