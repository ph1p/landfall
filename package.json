{
  "name": "landfall",
  "version": "0.12.3",
  "description": "Set up servers and deploy sites behind Traefik with automatic HTTPS",
  "keywords": [
    "cli",
    "deploy",
    "docker",
    "https",
    "self-hosted",
    "traefik",
    "vps"
  ],
  "homepage": "https://github.com/ph1p/landfall#readme",
  "bugs": "https://github.com/ph1p/landfall/issues",
  "license": "MIT",
  "author": "ph1p <me@ph1p.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ph1p/landfall.git"
  },
  "bin": {
    "landfall": "dist/cli.mjs",
    "lf": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli/cli.ts",
    "build": "tsdown && vite build",
    "docs:dev": "cd docs && vocs dev",
    "docs:build": "cd docs && vocs build",
    "prepublishOnly": "pnpm build",
    "test": "vitest run test/unit",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/ui/app",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "e2e": "pnpm build && bash test/e2e/run.sh",
    "dev:ui": "vite build --watch"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "string-width": "^9.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "lucide-react": "^1.73.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vocs": "2.14.1",
    "waku": "1.0.0-rc.5"
  },
  "engines": {
    "node": ">=22.4"
  },
  "packageManager": "pnpm@12.21.0"
}
